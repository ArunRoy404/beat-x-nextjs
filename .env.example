# ==============================================================================
# BeatX Environment Variables
# Copy this file to .env or .env.local and adjust values accordingly.
# ==============================================================================

# Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://13.200.168.40:3000/api/v1

# Enable/Disable API proxy middleware
NEXT_PUBLIC_USE_API_PROXY=false

# Global cache revalidation time in seconds (TanStack Query + ISR)
NEXT_PUBLIC_REVALIDATE_TIME=60

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
# Generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=your_nextauth_secret_here

# Required in the x-revalidate-secret header to call POST /api/revalidate
REVALIDATE_SECRET=your_revalidate_secret_here
